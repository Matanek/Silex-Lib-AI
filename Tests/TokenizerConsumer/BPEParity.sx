use AI.Tokenizer

func main() {
    let texts:str[] = ["",
        "abc",
        "abca",
        "aaaaa",
        "aaaaaa",
        "abababab",
        "abcabc",
        "baba",
        "aaaaaaaaaaaaaaaaa",
        "a",
