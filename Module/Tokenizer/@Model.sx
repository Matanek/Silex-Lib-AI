use STD.Collections.Dictionary
use STD.Text.UTF8
use STD.Regex

public enum LoadErrorKind {
    io
    invalid_options
    invalid_json
    invalid_vocabulary
    incomplete_alphabet
    invalid_merges
    invalid_special_tokens
    limit_exceeded
    unsupported_model
}

public struct LoadError {
    let kind:LoadErrorKind
    let path:str?
    let detail:str
}

public enum Normalization { identity; nfc; nfkc }
public enum PreTokenizer { none; gpt2 }

public struct LoadOptions {
    let maximum_file_bytes:int = 16 * 1024 * 1024
    let maximum_json_depth:int = 32
    let maximum_vocabulary_entries:int = 100_000
    let maximum_token_bytes:int = 4096
    let maximum_merge_rules:int = 100_000
    let normalization:Normalization = Normalization.identity
    let pre_tokenizer:PreTokenizer = PreTokenizer.none
    let special_tokens:SpecialToken[] = []
    let maximum_special_tokens:int = 256
    let maximum_special_bytes:int = 65536
}

public struct EncodeOptions {
    let maximum_input_bytes:int = 16 * 1024 * 1024
    let maximum_tokens:int = 16 * 1024 * 1024
    let maximum_normalized_bytes:int = 16 * 1024 * 1024
    let special_input:SpecialInput = SpecialInput.reject
    let boundary_tokens:BoundaryTokens = BoundaryTokens.none
}

public enum EncodeErrorKind { invalid_options; limit_exceeded; forbidden_special }
public struct EncodeError {
    let kind:EncodeErrorKind
    let detail:str
}

public struct DecodeOptions {
    let maximum_bytes:int = 16 * 1024 * 1024
    let special_tokens:DecodeSpecialTokens = DecodeSpecialTokens.include
}

public enum DecodeErrorKind { invalid_options; unknown_id; invalid_utf8; limit_exceeded }
public struct DecodeError {
    let kind:DecodeErrorKind
    let position:int
    let detail:str
}

public struct Span {
    let start:int
    let end:int
}

public struct Piece {
    let id:int
    let bytes:uint8[]
    let span:Span?
    let special:SpecialRole? = null
}

public struct Encoding {
    private let source:str
    private let values:Piece[]
    private let boundaries:Span[]

    module init(source:str, values:Piece[], boundaries:Span[]) {
        self.source = source
        self.values = values
        self.boundaries = boundaries
    }

    func normalized_text() str { return self.source }
    func count() int { return self.values.count() }
    func pieces() Piece[] { return self.values }
    func segments() Span[] { return self.boundaries }
    func ids() int[] {
        var result:int[] = []
        for piece in self.values { result.append(piece.id) }
        return result
    }
}

public class Tokenizer {
    private let byte_ids:int[]
    private let vocabulary:Dictionary<int, uint8[]>
    private let normalization:Normalization
    private let splitter:Regex?
    private let rules:Dictionary<TokenPair, MergeRule>
    private let controls:SpecialTable

    module init(byte_ids:int[], vocabulary:Dictionary<int, uint8[]>, normalization:Normalization, splitter:Regex?, rules:Dictionary<TokenPair, MergeRule>, controls:SpecialTable) {
        self.byte_ids = byte_ids
        self.vocabulary = vocabulary
        self.normalization = normalization
        self.splitter = splitter
        self.rules = rules
        self.controls = controls
    }

    static func load_bpe(vocabulary_path:str, merges_path:str, options:LoadOptions = LoadOptions()) Result<Tokenizer, LoadError> {
        return load_model(vocabulary_path, merges_path, options)
    }

    static func parse_bpe(vocabulary_json:str, merges_text:str, options:LoadOptions = LoadOptions()) Result<Tokenizer, LoadError> {
        return parse_model(vocabulary_json, merges_text, options, null, null)
    }

    func encode(text:str, options:EncodeOptions = EncodeOptions()) Result<Encoding, EncodeError> {
        if options.maximum_input_bytes < 0 || options.maximum_normalized_bytes < 0 || options.maximum_tokens < 0 {
            return Result<Encoding, EncodeError>.failure(EncodeError(
                kind:EncodeErrorKind.invalid_options, detail:"encoding limits must be non-negative"
            ))
        }
        // Check the encoded byte size before materializing input or output arrays.
        let input_count = UTF8.byte_count(text)
        if input_count > options.maximum_input_bytes {
            return Result<Encoding, EncodeError>.failure(EncodeError(
                kind:EncodeErrorKind.limit_exceeded, detail:"input exceeds the configured encoding limit"
            ))
        }
        let source = normalize_text(text, self.normalization)
        let normalized_count = UTF8.byte_count(source)
        if normalized_count > options.maximum_normalized_bytes {
            return Result<Encoding, EncodeError>.failure(EncodeError(
                kind:EncodeErrorKind.limit_exceeded, detail:"normalized text exceeds the configured encoding limit"
            ))
        }
        let allowed = try self.controls.allowed(options.special_input)
        let added = try self.controls.boundaries(options.boundary_tokens)
        let bytes = UTF8.bytes(source)
        let matches = self.controls.find(bytes, options.special_input)
        var boundaries:Span[] = []
        var pieces:Piece[] = []
        if added.first >= 0 { try append_control(pieces, self.controls.values[added.first], null, options.maximum_tokens) }
        var cursor = 0
        for found in matches {
            if !allowed.contains(self.controls.values[found.index].id) {
                return Result<Encoding, EncodeError>.failure(EncodeError(kind:EncodeErrorKind.forbidden_special,
                    detail:"literal special token is not allowed at byte $(found.start)"))
            }
            try self.encode_region(bytes, cursor, found.start, pieces, boundaries, options.maximum_tokens)
            let span = Span(start:found.start, end:found.end)
            boundaries.append(span)
            try append_control(pieces, self.controls.values[found.index], span, options.maximum_tokens)
            cursor = found.end
        }
        try self.encode_region(bytes, cursor, bytes.count(), pieces, boundaries, options.maximum_tokens)
        if added.last >= 0 { try append_control(pieces, self.controls.values[added.last], null, options.maximum_tokens) }
        return Result<Encoding, EncodeError>.success(Encoding(source, pieces, boundaries))
    }

    func special_tokens() SpecialToken[] { return self.controls.values }

    private func encode_region(bytes:@uint8[], start:int, end:int, pieces:&Piece[], boundaries:&Span[], maximum_tokens:int) Result<void, EncodeError> {
        if start == end { return Result<void, EncodeError>.success() }
        let view = @bytes[start:end]
        // Regions terminate at validated UTF-8 special surfaces, hence scalar boundaries.
        let text = try UTF8.decode(view) else { panic("invalid internal UTF-8 region") }
        for relative in text_segments(text, self.splitter) {
            let boundary = Span(start:start + relative.start, end:start + relative.end)
            boundaries.append(boundary)
            var segment:Piece[] = []
            if self.rules.count() == 0 {
                var index = boundary.start
                while index < boundary.end {
                    let values:uint8[] = [bytes[index]]
                    segment.append(Piece(id:self.byte_ids[bytes[index] as int], bytes:values,
                        span:Span(start:index, end:index + 1)))
                    index++
                }
            } else {
                var merger = SegmentMerger(bytes, boundary, self.byte_ids, self.rules)
                segment = merger.pieces(bytes)
            }
            for piece in segment {
                if pieces.count() >= maximum_tokens {
                    return Result<void, EncodeError>.failure(EncodeError(
                        kind:EncodeErrorKind.limit_exceeded, detail:"encoding exceeds the configured token limit"))
                }
                pieces.append(piece)
            }
        }
        return Result<void, EncodeError>.success()
    }

    func decode_bytes(ids:int[], options:DecodeOptions = DecodeOptions()) Result<uint8[], DecodeError> {
        if options.maximum_bytes < 0 {
            return Result<uint8[], DecodeError>.failure(DecodeError(
                kind:DecodeErrorKind.invalid_options, position:0, detail:"decoding limit must be non-negative"
            ))
        }
        var result:uint8[] = []
        var index = 0
        for id in ids {
            if control = self.controls.by_id.find(id) {
                if options.special_tokens == DecodeSpecialTokens.skip { index++; continue }
                let bytes = UTF8.bytes(control.surface)
                if bytes.count() > options.maximum_bytes - result.count() {
                    return Result<uint8[], DecodeError>.failure(DecodeError(kind:DecodeErrorKind.limit_exceeded,
                        position:index, detail:"decoded bytes exceed the configured limit"))
                }
                for byte in bytes { result.append(byte) }
                index++
                continue
            }
            let found = self.vocabulary.find(id)
            if found == null {
                return Result<uint8[], DecodeError>.failure(DecodeError(
                    kind:DecodeErrorKind.unknown_id, position:index, detail:"unknown token ID $(id)"
                ))
            }
            let bytes = found!
            if bytes.count() > options.maximum_bytes - result.count() {
                return Result<uint8[], DecodeError>.failure(DecodeError(
                    kind:DecodeErrorKind.limit_exceeded, position:index, detail:"decoded bytes exceed the configured limit"
                ))
            }
            for byte in bytes { result.append(byte) }
            index++
        }
        return Result<uint8[], DecodeError>.success(result)
    }

    func decode(ids:int[], options:DecodeOptions = DecodeOptions()) Result<str, DecodeError> {
        let bytes = try self.decode_bytes(ids, options)
        let view = @bytes[0:bytes.count()]
        match UTF8.decode(view) {
            success(text) => { return Result<str, DecodeError>.success(text) }
            failure(error) => {
                return Result<str, DecodeError>.failure(DecodeError(
                    kind:DecodeErrorKind.invalid_utf8, position:error.byte_offset,
                    detail:"decoded bytes are not valid UTF-8"
                ))
            }
        }
    }
}
